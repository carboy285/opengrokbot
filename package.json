{
  "name": "opengrokbot-windows",
  "version": "0.2.0",
  "private": true,
  "description": "Independent OpenGrokBot desktop workspace, offline preview",
  "author": "OpenGrokBot contributors",
  "license": "MIT",
  "main": "desktop-windows/app/main.cjs",
  "scripts": {
    "start:windows": "electron .",
    "test:desktop": "node --test desktop-windows/app/*.test.cjs",
    "dist:windows": "electron-builder --win nsis --x64",
    "preview:desktop": "python3 -m http.server 4173 --bind 127.0.0.1 --directory desktop-windows/renderer",
    "test:ui": "node scripts/test-desktop-ui.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "org.opengrokbot.windows",
    "productName": "OpenGrokBot",
    "directories": {
      "output": "artifacts/windows"
    },
    "files": [
      "desktop-windows/app/**/*",
      "desktop-windows/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OpenGrokBot-${version}-Windows-${arch}-Setup.${ext}"
    }
  }
}
